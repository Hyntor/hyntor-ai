// The only schema file (ADR-0002). Written for PostgreSQL; scripts/prisma.ts swaps the provider line when
// DATABASE_URL points at SQLite. Keep it portable: no @db.* native types, no PostgreSQL-only features.
// Entities and constraints follow the ERD in M2 section 4 (FND-5, #10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  learner
  admin
}

enum CourseRole {
  member
  maintainer
}

enum FileKind {
  pdf
  docx
  pptx
}

enum ExtractionStatus {
  pending
  indexed
  failed
}

enum TutorMode {
  concept
  assignment
}

enum MessageAuthorRole {
  student
  assistant
}

/// A school. Signup is allowed only for addresses at a registered email domain (A1, E1).
model University {
  id          String   @id @default(cuid())
  name        String
  emailDomain String   @unique
  createdAt   DateTime @default(now())

  users   User[]
  courses Course[]
}

model User {
  id              String       @id @default(cuid())
  universityId    String
  email           String       @unique
  displayName     String
  passwordHash    String
  platformRole    PlatformRole @default(learner)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())

  university        University     @relation(fields: [universityId], references: [id])
  sessions          Session[]
  enrollments       Enrollment[]
  uploadedMaterials Material[]     @relation("MaterialUploader")
  removedMaterials  Material[]     @relation("MaterialRemover")
  tutorSessions     TutorSession[]

  @@index([universityId])
}

/// A signed-in browser. Only the SHA-256 of the cookie token is stored; the raw token never is (ADR-0007).
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A course persists across terms; there is deliberately no term column here (G2). Terms live on Enrollment.
model Course {
  id           String   @id @default(cuid())
  universityId String
  code         String
  title        String
  createdAt    DateTime @default(now())

  university    University     @relation(fields: [universityId], references: [id])
  enrollments   Enrollment[]
  materials     Material[]
  tutorSessions TutorSession[]

  @@unique([universityId, code])
}

/// Membership of one user in one course for one term, e.g. "2026-FA".
model Enrollment {
  userId     String
  courseId   String
  term       String
  courseRole CourseRole @default(member)
  joinedAt   DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId, term])
  @@index([courseId, term])
}

/// An uploaded file. The same bytes can be uploaded once per course (C4); removal is a soft delete (E3).
model Material {
  id               String           @id @default(cuid())
  courseId         String
  uploaderId       String
  title            String
  fileKind         FileKind
  storageKey       String           @unique
  byteSize         Int
  sha256           String
  extractionStatus ExtractionStatus @default(pending)
  uploadedAt       DateTime         @default(now())
  removedAt        DateTime?
  removedById      String?

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader  User            @relation("MaterialUploader", fields: [uploaderId], references: [id])
  removedBy User?           @relation("MaterialRemover", fields: [removedById], references: [id])
  chunks    MaterialChunk[]

  @@unique([courseId, sha256])
  @@index([courseId, uploadedAt])
  @@index([uploaderId])
  @@index([removedById])
}

/// An ordered slice of a material's extracted text. A material has zero chunks until extraction succeeds.
model MaterialChunk {
  id         String @id @default(cuid())
  materialId String
  ordinal    Int
  text       String
  charCount  Int

  material  Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  citations MessageCitation[]

  @@unique([materialId, ordinal])
}

model TutorSession {
  id             String    @id @default(cuid())
  courseId       String
  studentId      String
  mode           TutorMode
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([courseId, studentId])
  @@index([studentId])
}

/// One turn in a tutor session. hintTier is set on assistant replies only.
model TutorMessage {
  id              String            @id @default(cuid())
  tutorSessionId  String
  ordinal         Int
  authorRole      MessageAuthorRole
  body            String
  hintTier        Int?
  beyondMaterials Boolean           @default(false)
  createdAt       DateTime          @default(now())

  tutorSession TutorSession      @relation(fields: [tutorSessionId], references: [id], onDelete: Cascade)
  citations    MessageCitation[]

  @@unique([tutorSessionId, ordinal])
}

/// Which chunks an assistant message cited.
model MessageCitation {
  messageId String
  chunkId   String

  message TutorMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   MaterialChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([messageId, chunkId])
  @@index([chunkId])
}
