# Copy to .env at the repository root (cp .env.example .env). .env is git-ignored; never commit real values.
# The app, the Prisma scripts and the tests all read this one file.

# Database (ADR-0002). SQLite for local development: no server to install. Relative paths are resolved
# against the repository root. CI and production use PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hyntor"
# After switching provider, run `npm run db:generate`.
DATABASE_URL="file:./dev.db"

# Database the tests may wipe. Optional with SQLite (defaults to ./test.db); required when DATABASE_URL is
# PostgreSQL, and must use the same provider.
TEST_DATABASE_URL=""

# Where uploaded files are stored in development (ADR-0005). Relative to the repository root.
STORAGE_DIR=".storage"

# Password for every account `npm run db:seed` creates. Leave empty for the documented demo password.
SEED_PASSWORD=""

# Gemini (ADR-0003). Server-only: never prefix with NEXT_PUBLIC_. Leave the key empty to run in no-key mode
# (the tutor shows a setup notice). Used from the tutor issues (TUT-*) onwards.
GEMINI_API_KEY=""
GEMINI_MODEL=""
