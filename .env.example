# Copy to .env at the repository root (cp .env.example .env). .env is git-ignored; never commit real values.
# The site, the management commands and the tests all read this one file.

# Django secret key. The development default in settings.py is insecure; production must set this.
# Leave empty in development and Django uses a built-in insecure key. With DJANGO_DEBUG="0" an
# empty value stops the site from starting, so a real deployment can never run on a published key.
DJANGO_SECRET_KEY=""

# 1 in development, 0 in production.
DJANGO_DEBUG="1"

# Comma-separated hostnames the site answers on.
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# Comma-separated origins allowed to post forms, e.g. "https://hyntor.example.com". Needed in production.
DJANGO_CSRF_TRUSTED_ORIGINS=""

# Database. Leave empty for local development: Django uses the SQLite file dev.sqlite3, so there is no
# server to install. CI and production set PostgreSQL, and nothing else changes:
#   DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/hyntor"
DATABASE_URL=""

# Where uploaded files are stored in development (ADR-0005). Relative paths are read from the repository root.
STORAGE_DIR=".storage"

# Gemini (ADR-0003). Server-only. Leave the key empty to run in no-key mode, where the tutor shows a setup
# notice instead of calling the model. Used from the tutor issues (TUT-*) onwards.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# The Streamlit tutor service (ADR-0011). Empty means no tutor is configured and /tutor/ says so.
TUTOR_CHAT_URL=""

# Shared with the tutor service; signs the hand-off token that identifies the signed-in user.
# Empty falls back to DJANGO_SECRET_KEY, which is fine locally because both run on one machine.
HANDOFF_SECRET=""

# Where the tutor keeps long-term memories.
MEMORY_DB_PATH="memories.db"

# Sign in with Google (ADR-0012). Leave both empty and the button is hidden; password sign-in still
# works. Create an OAuth client in Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID > Web application) and register these as Authorised redirect URIs:
#   http://localhost:8000/auth/google/callback/
#   https://<your-render-host>/auth/google/callback/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
