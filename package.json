{
  "name": "hyntor-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @hyntor/web",
    "build": "npm run build -w @hyntor/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @hyntor/db",
    "db:migrate": "npm run db:migrate -w @hyntor/db",
    "db:migration:create": "npm run db:migration:create -w @hyntor/db --",
    "db:seed": "npm run db:seed -w @hyntor/db",
    "db:reset": "npm run db:reset -w @hyntor/db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
